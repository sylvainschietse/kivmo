# ─────────────────────────────────────────────────────────────
# KIVMO — fichier d'environnement d'exemple (aucun secret réel)
# Copier vers .env.local puis compléter.
# ─────────────────────────────────────────────────────────────

# Base PostgreSQL (16+). Les migrations sont dans ./drizzle (npm run db:migrate).
DATABASE_URL=postgres://kivmo:kivmo@localhost:5432/kivmo
DATABASE_POOL_MAX=10
# Base dédiée aux tests d'intégration (réinitialisée à chaque exécution !)
TEST_DATABASE_URL=postgres://kivmo:kivmo@localhost:5432/kivmo_test

# URL publique de l'application (liens de connexion, invitations)
APP_URL=http://localhost:3000
# Secret de signature des sessions et URL temporaires (32+ caractères aléatoires). OBLIGATOIRE en production.
SESSION_SECRET=
# Stockage privé des pièces jointes (hors du dossier public). En production : volume chiffré ou stockage objet.
STORAGE_DIR=./storage
# disk (défaut en local) ou db (défaut sur Vercel : fichiers conservés dans PostgreSQL)
STORAGE_BACKEND=
# Mode démonstration (sans compte) : on | off
DEMO_MODE=on
# Secret partagé pour déclencher les tâches planifiées (/api/cron/*), en-tête Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Email (liens de connexion, invitations) ──
# console : développement (lien affiché à l'écran et dans les journaux) ; smtp : fournisseur réel
EMAIL_PROVIDER=console
SMTP_URL=
EMAIL_FROM="KIVMO <no-reply@example.invalid>"

# ── Prix des carburants (France) — À CONNECTER après vérification des conditions de la source ──
# FUEL_PRICES_SOURCE=prix-carburants active l'import serveur du flux public.
FUEL_PRICES_SOURCE=
FUEL_PRICES_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records

# ── Cartographie — À CONNECTER (vérifier quotas, licence et attribution du fournisseur) ──
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ── Calcul d'itinéraire — À CONNECTER ──
ROUTING_PROVIDER=
ROUTING_API_KEY=

# ── Lecture des photos (compteur, pompe, ticket, carte grise) — service de vision Claude ──
# Clé à créer sur https://console.anthropic.com (Settings > API keys). Vide = saisie manuelle seulement.
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif) : claude-haiku-5-5 par défaut (rapide et peu coûteux).
OCR_MODEL=
# Plafond global de lectures de photos par jour, tous comptes confondus (défaut : 500).
OCR_DAILY_LIMIT=

# ── Banque — bac à sable intégré ; production À CONNECTER après contrat et vérification des capacités ──
BANK_ENVIRONMENT=sandbox
BANK_PROVIDER=
BANK_CLIENT_ID=
BANK_CLIENT_SECRET=
# Secret HMAC des webhooks bancaires (obligatoire hors développement)
BANK_WEBHOOK_SECRET=

# ── Notifications push — À CONNECTER ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Facturation professionnelle — À CONNECTER (aucun tarif décidé) ──
BILLING_PROVIDER=
BILLING_API_KEY=
